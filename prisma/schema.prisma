generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Broker {
  id                 String                 @id @default(cuid())
  name               String                 @unique
  displayName        String                 @map("display_name")
  isActive           Boolean                @default(true) @map("is_active")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  authMethod         String                 @map("auth_method")
  authConfig         Json                   @map("auth_config")
  baseUrl            String                 @map("base_url")
  apiVersion         String?                @map("api_version")
  headers            Json
  tokenTypes         Json                   @map("token_types")
  tokenRefreshConfig Json                   @map("token_refresh_config")
  rateLimit          Json?                  @map("rate_limit")
  metadata           Json?
  orders             Order[]
  requestLogs        RequestLog[]
  userCredentials    UserBrokerCredential[]

  @@map("brokers")
}

model UserBrokerCredential {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  brokerId    String    @map("broker_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  credentials Json
  tokens      Json?
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  orders      Order[]
  broker      Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@unique([userId, brokerId])
  @@map("user_broker_credentials")
}

model Order {
  id               String               @id @default(cuid())
  requestId        String               @unique @map("request_id")
  userId           String               @map("user_id")
  brokerId         String               @map("broker_id")
  credentialId     String               @map("credential_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  symbol           String
  exchange         String
  orderType        String               @map("order_type")
  productType      String               @map("product_type")
  quantity         Int
  price            Decimal?
  triggerPrice     Decimal?             @map("trigger_price")
  validity         String?
  brokerOrderId    String?              @map("broker_order_id")
  status           String               @default("pending")
  statusMessage    String?              @map("status_message")
  executedQuantity Int?                 @default(0) @map("executed_quantity")
  executedPrice    Decimal?             @map("executed_price")
  executedAt       DateTime?            @map("executed_at")
  brokerMetadata   Json?                @map("broker_metadata")
  broker           Broker               @relation(fields: [brokerId], references: [id])
  credential       UserBrokerCredential @relation(fields: [credentialId], references: [id])
  requestLogs      RequestLog[]

  @@map("orders")
}

model RequestLog {
  id           String   @id @default(cuid())
  requestId    String   @map("request_id")
  brokerId     String?  @map("broker_id")
  orderId      String?  @map("order_id")
  createdAt    DateTime @default(now()) @map("created_at")
  method       String
  endpoint     String
  headers      Json?
  payload      Json?
  statusCode   Int?     @map("status_code")
  response     Json?
  responseTime Int?     @map("response_time")
  level        String
  message      String?
  error        Json?
  broker       Broker?  @relation(fields: [brokerId], references: [id])
  order        Order?   @relation(fields: [orderId], references: [id])

  @@map("request_logs")
}
